          package com.example.nowplaying

          import android.appwidget.AppWidgetManager
          import android.appwidget.AppWidgetProvider
          import android.content.Context
          import android.content.Intent
          import android.os.Handler
          import android.os.Looper

          class NowPlayingWidget : AppWidgetProvider() {
              override fun onUpdate(context: Context, mgr: AppWidgetManager, ids: IntArray) {
                  WidgetUpdater.update(context)
              }

              override fun onReceive(context: Context, intent: Intent) {
                  super.onReceive(context, intent)
                  val action = intent.action ?: return
                  if (action != WidgetUpdater.ACTION_PREV && action != WidgetUpdater.ACTION_NEXT &&
                      action != WidgetUpdater.ACTION_PLAY && action != WidgetUpdater.ACTION_PICK &&
                      action != WidgetUpdater.ACTION_PLAY_URI
                  ) return
                  val c = WidgetUpdater.activeController(context) ?: return

                  var forced: Boolean? = null
                  when (action) {
                      WidgetUpdater.ACTION_PREV -> WidgetUpdater.handleSkip(context, c, false)
                      WidgetUpdater.ACTION_NEXT -> WidgetUpdater.handleSkip(context, c, true)
                      WidgetUpdater.ACTION_PLAY -> {
                          val playing = WidgetUpdater.isPlaying(c)
                          if (playing) c.transportControls.pause() else c.transportControls.play()
                          forced = !playing
                      }
                      WidgetUpdater.ACTION_PICK -> {
                          val id = intent.getLongExtra("id", -1L)
                          if (id >= 0) c.transportControls.skipToQueueItem(id)
                      }
                      WidgetUpdater.ACTION_PLAY_URI -> {
                          val uri = intent.getStringExtra("uri")
                          if (!uri.isNullOrBlank()) {
                              c.transportControls.playFromUri(android.net.Uri.parse(uri), null)
                              forced = true
                          }
                      }
                  }

                  WidgetUpdater.update(context, forced)
                  val pending = goAsync()
                  val handler = Handler(Looper.getMainLooper())
                  handler.postDelayed({ WidgetUpdater.update(context) }, 350)
                  handler.postDelayed({
                      WidgetUpdater.update(context)
                      pending.finish()
                  }, 1200)
              }
          }
