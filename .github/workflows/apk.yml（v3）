          cat > app/src/main/java/com/example/nowplaying/WidgetUpdater.kt <<'EOF'
          package com.example.nowplaying

          import android.app.PendingIntent
          import android.appwidget.AppWidgetManager
          import android.content.ComponentName
          import android.content.ContentUris
          import android.content.Context
          import android.content.Intent
          import android.graphics.Bitmap
          import android.graphics.BitmapFactory
          import android.media.MediaMetadata
          import android.media.session.MediaController
          import android.media.session.MediaSessionManager
          import android.media.session.PlaybackState
          import android.net.Uri
          import android.provider.MediaStore
          import android.widget.RemoteViews
          import java.net.HttpURLConnection
          import java.net.URL

          class Track(
              val title: String,
              val artist: String,
              val num: Int,
              val current: Boolean,
              val queueId: Long,
              val uri: String?
          )

          class Listing(val header: String, val tracks: List<Track>, val album: Boolean)

          object WidgetUpdater {
              const val ACTION_PREV = "com.example.nowplaying.PREV"
              const val ACTION_PLAY = "com.example.nowplaying.PLAY"
              const val ACTION_NEXT = "com.example.nowplaying.NEXT"
              const val ACTION_PICK = "com.example.nowplaying.PICK"
              const val ACTION_PLAY_URI = "com.example.nowplaying.PLAYURI"

              @Volatile private var lastPkg: String? = null
              @Volatile private var artKey: String? = null
              @Volatile private var artBmp: Bitmap? = null
              @Volatile private var forcedPlaying: Boolean? = null
              @Volatile private var forcedAt: Long = 0L

              fun isPlaying(c: MediaController): Boolean {
                  val s = c.playbackState?.state
                  return s == PlaybackState.STATE_PLAYING || s == PlaybackState.STATE_BUFFERING
              }

              fun activeController(ctx: Context): MediaController? {
                  return try {
                      val msm = ctx.getSystemService(MediaSessionManager::class.java)
                      val list = msm.getActiveSessions(ComponentName(ctx, MusicListener::class.java))
                      val playing = list.firstOrNull { isPlaying(it) }
                      if (playing != null) {
                          lastPkg = playing.packageName
                          playing
                      } else {
                          list.firstOrNull { it.packageName == lastPkg && it.metadata != null }
                              ?: list.firstOrNull { it.metadata != null }
                      }
                  } catch (e: SecurityException) {
                      null
                  }
              }

              private fun pi(ctx: Context, action: String): PendingIntent =
                  PendingIntent.getBroadcast(
                      ctx, action.hashCode(),
                      Intent(ctx, NowPlayingWidget::class.java).setAction(action),
                      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                  )

              private fun pickTemplate(ctx: Context): PendingIntent =
                  PendingIntent.getBroadcast(
                      ctx, ACTION_PICK.hashCode(),
                      Intent(ctx, NowPlayingWidget::class.java).setAction(ACTION_PICK),
                      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE
                  )

              private fun uriTemplate(ctx: Context): PendingIntent =
                  PendingIntent.getBroadcast(
                      ctx, ACTION_PLAY_URI.hashCode(),
                      Intent(ctx, NowPlayingWidget::class.java).setAction(ACTION_PLAY_URI),
                      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE
                  )

              private fun scaled(b: Bitmap, max: Int = 320): Bitmap {
                  val r = max.toFloat() / maxOf(b.width, b.height)
                  if (r >= 1f) return b
                  val w = (b.width * r).toInt().coerceAtLeast(1)
                  val h = (b.height * r).toInt().coerceAtLeast(1)
                  return Bitmap.createScaledBitmap(b, w, h, true)
              }

              private fun rounded(b: Bitmap, radius: Float): Bitmap {
                  val out = Bitmap.createBitmap(b.width, b.height, Bitmap.Config.ARGB_8888)
                  val canvas = android.graphics.Canvas(out)
                  val paint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
                  val rect = android.graphics.RectF(0f, 0f, b.width.toFloat(), b.height.toFloat())
                  canvas.drawRoundRect(rect, radius, radius, paint)
                  paint.xfermode = android.graphics.PorterDuffXfermode(android.graphics.PorterDuff.Mode.SRC_IN)
                  canvas.drawBitmap(b, 0f, 0f, paint)
                  return out
              }

              private fun loadArt(ctx: Context, md: MediaMetadata?): Bitmap? {
                  if (md == null) return null
                  val direct = md.getBitmap(MediaMetadata.METADATA_KEY_ART)
                      ?: md.getBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART)
                      ?: md.getBitmap(MediaMetadata.METADATA_KEY_DISPLAY_ICON)
                  if (direct != null) return direct
                  val uriStr = md.getString(MediaMetadata.METADATA_KEY_ART_URI)
                      ?: md.getString(MediaMetadata.METADATA_KEY_ALBUM_ART_URI)
                      ?: md.getString(MediaMetadata.METADATA_KEY_DISPLAY_ICON_URI)
                      ?: return null
                  if (uriStr == artKey) return artBmp
                  artKey = uriStr
                  artBmp = null
                  Thread {
                      val bmp: Bitmap? = try {
                          val u = Uri.parse(uriStr)
                          if (u.scheme == "http" || u.scheme == "https") {
                              val conn = URL(uriStr).openConnection() as HttpURLConnection
                              conn.connectTimeout = 8000
                              conn.readTimeout = 8000
                              conn.inputStream.use { BitmapFactory.decodeStream(it) }
                          } else {
                              ctx.contentResolver.openInputStream(u)?.use { BitmapFactory.decodeStream(it) }
                          }
                      } catch (e: Exception) {
                          null
                      }
                      if (bmp != null && artKey == uriStr) {
                          artBmp = bmp
                          update(ctx)
                      }
                  }.start()
                  return null
              }

              private fun albumTracks(ctx: Context, album: String, currentTitle: String?, currentArtist: String?): List<Track> {
                  val out = mutableListOf<Track>()
                  try {
                      val base = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
                      val proj = arrayOf(
                          MediaStore.Audio.Media._ID,
                          MediaStore.Audio.Media.TITLE,
                          MediaStore.Audio.Media.ARTIST
                      )
                      val sel = "${MediaStore.Audio.Media.ALBUM} = ? AND ${MediaStore.Audio.Media.IS_MUSIC} != 0"
                      val order = "${MediaStore.Audio.Media.TRACK} ASC"
                      ctx.contentResolver.query(base, proj, sel, arrayOf(album), order)?.use { cur ->
                          var i = 0
                          while (cur.moveToNext()) {
                              i++
                              val id = cur.getLong(0)
                              val t = cur.getString(1) ?: ""
                              val a = cur.getString(2) ?: ""
                              val uri = ContentUris.withAppendedId(base, id).toString()
                              val cur = t == currentTitle && (currentArtist.isNullOrBlank() || a == currentArtist)
                              out.add(Track(t, a, i, cur, -1L, uri))
                          }
                      }
                  } catch (e: Exception) {
                  }
                  return out
              }

              fun listing(ctx: Context, c: MediaController?): Listing {
                  val md = c?.metadata
                  val q = c?.queue
                  if (c != null && !q.isNullOrEmpty()) {
                      val activeId = c.playbackState?.activeQueueItemId ?: -1L
                      var idx = -1
                      val tracks = q.mapIndexed { i, item ->
                          val cur = item.queueId == activeId
                          if (cur) idx = i
                          Track(
                              item.description.title?.toString() ?: "",
                              item.description.subtitle?.toString() ?: "",
                              i + 1, cur, item.queueId, null
                          )
                      }
                      val pos = if (idx >= 0) (idx + 1).toString() else "-"
                      return Listing("現在のキュー ($pos/${q.size})", tracks, false)
                  }
                  if (md != null) {
                      val album = md.getString(MediaMetadata.METADATA_KEY_ALBUM)
                      if (!album.isNullOrBlank()) {
                          val title = md.getString(MediaMetadata.METADATA_KEY_TITLE)
                          val artist = md.getString(MediaMetadata.METADATA_KEY_ARTIST)
                              ?: md.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST)
                          val tracks = albumTracks(ctx, album, title, artist)
                          if (tracks.isNotEmpty()) {
                              val idx = tracks.indexOfFirst { it.current }
                              val pos = if (idx >= 0) (idx + 1).toString() else "-"
                              return Listing("$album ($pos/${tracks.size})", tracks, true)
                          }
                      }
                  }
                  return Listing("", emptyList(), false)
              }

              fun handleSkip(ctx: Context, c: MediaController, forward: Boolean) {
                  val l = listing(ctx, c)
                  val cur = l.tracks.indexOfFirst { it.current }
                  if (l.tracks.size > 1 && cur >= 0) {
                      val atEdge = if (forward) cur == l.tracks.size - 1 else cur == 0
                      if (atEdge) {
                          val target = if (forward) l.tracks.first() else l.tracks.last()
                          when {
                              target.uri != null ->
                                  c.transportControls.playFromUri(Uri.parse(target.uri), null)
                              target.queueId >= 0 ->
                                  c.transportControls.skipToQueueItem(target.queueId)
                              forward -> c.transportControls.skipToNext()
                              else -> c.transportControls.skipToPrevious()
                          }
                          return
                      }
                  }
                  if (forward) c.transportControls.skipToNext() else c.transportControls.skipToPrevious()
              }

              fun update(ctx: Context, playingOverride: Boolean? = null) {
                  val app = ctx.applicationContext
                  val mgr = AppWidgetManager.getInstance(app)
                  val ids = mgr.getAppWidgetIds(ComponentName(app, NowPlayingWidget::class.java))
                  if (ids.isEmpty()) return

                  val c = activeController(app)
                  val md = c?.metadata
                  val title = md?.getString(MediaMetadata.METADATA_KEY_TITLE)
                  val artist = md?.getString(MediaMetadata.METADATA_KEY_ARTIST)
                      ?: md?.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST)
                  val art = loadArt(app, md)?.let { rounded(scaled(it), 36f) }
                  val actualPlaying = c != null && isPlaying(c)
                  var playing = actualPlaying
                  if (playingOverride != null) {
                      forcedPlaying = playingOverride
                      forcedAt = System.currentTimeMillis()
                      playing = playingOverride
                  } else {
                      val f = forcedPlaying
                      if (f != null) {
                          if (actualPlaying == f) {
                              forcedPlaying = null
                          } else if (System.currentTimeMillis() - forcedAt < 3000) {
                              playing = f
                          } else {
                              forcedPlaying = null
                          }
                      }
                  }
                  val l = listing(app, c)

                  val rv = RemoteViews(app.packageName, R.layout.widget)
                  rv.setTextViewText(R.id.title, title ?: "再生中の曲なし")
                  rv.setTextViewText(R.id.artist, artist ?: "")
                  if (art != null) rv.setImageViewBitmap(R.id.art, art)
                  else rv.setImageViewResource(R.id.art, android.R.drawable.ic_media_play)
                  rv.setImageViewResource(
                      R.id.play,
                      if (playing) R.drawable.ic_pause else R.drawable.ic_play
                  )
                  rv.setOnClickPendingIntent(R.id.prev, pi(app, ACTION_PREV))
                  rv.setOnClickPendingIntent(R.id.play, pi(app, ACTION_PLAY))
                  rv.setOnClickPendingIntent(R.id.next, pi(app, ACTION_NEXT))

                  val openPi: PendingIntent? = c?.sessionActivity
                      ?: c?.packageName?.let { pkg ->
                          app.packageManager.getLaunchIntentForPackage(pkg)?.let {
                              PendingIntent.getActivity(app, 4, it, PendingIntent.FLAG_IMMUTABLE)
                          }
                      }
                  if (openPi != null) {
                      for (id in listOf(R.id.root, R.id.art, R.id.title, R.id.artist, R.id.queue_header, R.id.empty)) {
                          rv.setOnClickPendingIntent(id, openPi)
                      }
                  }

                  rv.setTextViewText(R.id.queue_header, l.header)
                  rv.setRemoteAdapter(R.id.queue_list, Intent(app, QueueService::class.java))
                  rv.setEmptyView(R.id.queue_list, R.id.empty)
                  val template = if (l.album) uriTemplate(app) else pickTemplate(app)
                  rv.setPendingIntentTemplate(R.id.queue_list, template)
                  val cur = l.tracks.indexOfFirst { it.current }
                  if (cur >= 0) rv.setScrollPosition(R.id.queue_list, cur)

                  mgr.updateAppWidget(ids, rv)
                  mgr.notifyAppWidgetViewDataChanged(ids, R.id.queue_list)
              }
          }
